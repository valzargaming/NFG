{
  "name": "note-form-generator",
  "version": "0.2.0",
  "private": false,
  "scripts": {
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cs-fixer": "prettier --write \"**/*.{js,html,json,css,md}\" && npm run lint:fix",
    "cs-fixer:prettier": "prettier --write \"**/*.{js,html,json,css,md}\"",
    "cs-fixer:eslint": "npm run lint:fix",
    "build:html": "node scripts/generate-html.js",
    "build": "npm run build:html && esbuild src/index.js --bundle --format=esm --outfile=dist/index.esm.js && esbuild src/index.js --bundle --format=cjs --outfile=dist/index.cjs.js",
    "build:browser": "npm run build:html && esbuild src/index.js --bundle --format=iife --global-name=NFG --outfile=dist/form-generator.js --minify",
    "build:all": "npm run build && npm run build:browser",
    "prepare": "npm run build",
    "detect-useless-try": "node src/tools/detect_useless_try.js"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist/",
    "src/form-generator.html"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testTimeout": 10000,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{js,html}",
      "!src/index.js",
      "!src/embedded-html.js",
      "!src/tools/**"
    ],
    "coverageDirectory": "coverage",
    "transform": {
      "^.+\\.html$": "<rootDir>/tests/html-transformer.js"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.54.2",
    "@html-eslint/parser": "^0.54.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "jsdom": "^22.1.0",
    "prettier": "^2.8.8",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0"
  }
}
